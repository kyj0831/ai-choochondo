# ── 판정용 LLM 키 (둘 중 하나만) ────────────────────────────────────────
# 붙여넣은 AI 답변을 채점(판정)하는 데 쓰는 키. 비어 있으면 자동으로
# 데모(목업) 모드로 동작합니다.
# 값을 비워두면 데모 모드로 동작한다. 여기에 예시 문자열(sk-... 같은)을 두면
# 안 된다 — start.command가 그걸 진짜 키로 오인해 실제 호출을 시도하다 401이 난다.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Dev/test only: set to 1 to bypass real LLM calls and use deterministic
# sample responses (query generation, evidence judgment, report writing).
MOCK_LLM=0

# ── 자동 수집용 엔진 키 (선택, 여러 개 동시 설정 가능) ──────────────────
# 증거 수집 화면의 "자동 수집" 버튼이 실제로 호출할 엔진들. 키가 있는
# 엔진만 호출되고, 없는 엔진은 조용히 건너뜁니다. 위 판정용 키와는
# 별개다 — OPENAI_API_KEY는 판정에도, ChatGPT 자동 수집에도 둘 다 쓰인다.
#
# Claude(ANTHROPIC_API_KEY)는 이미 위에 있으면 자동 수집에도 그대로 쓰입니다.
# GEMINI_API_KEY=...           # https://aistudio.google.com/apikey
# PERPLEXITY_API_KEY=pplx-...  # https://www.perplexity.ai/settings/api
#
# Perplexity는 API 자체가 실시간 웹 검색이라 응답에 실제 출처 URL이
# 함께 온다 — 4개 엔진 중 "근거 부록"이 가장 잘 채워지는 엔진이다.
# ChatGPT·Claude·Gemini 기본 호출은 웹 검색 없이 학습 지식으로만 답하므로
# 인용이 붙지 않는 경우가 흔하다.
#
# 모델을 바꾸고 싶으면 (기본값 미표기 시 각각 gpt-4o-mini/claude-opus-4-8/
# gemini-2.0-flash/sonar):
# OPENAI_PROBE_MODEL=gpt-4o
# ANTHROPIC_PROBE_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-2.0-flash
# PERPLEXITY_MODEL=sonar-pro

# ── 접근 제한 ────────────────────────────────────────────────────────
# 설정하면 진단 화면·API에 비밀번호 게이트가 걸립니다.
# 비워 두면 게이트가 꺼집니다(로컬 개발용).
# 배포 시에는 반드시 설정하세요 — 없으면 URL을 아는 누구나 진단 데이터를 봅니다.
#
# 단, AI 프로필 허브(/p/*)·robots.txt·sitemap.xml은 항상 공개입니다.
# AI 크롤러가 읽어가는 것이 그 페이지의 목적이기 때문입니다.
APP_PASSWORD=
# 쿠키 해시용 임의 문자열. 바꾸면 기존 로그인 세션이 모두 만료됩니다.
AUTH_SECRET=

# ── 데이터 저장 위치 ──────────────────────────────────────────────────
# 배포 시 영구 볼륨 경로를 지정하세요(예: Railway 볼륨 마운트 /data).
# 미설정 시 프로젝트 내 data/ 폴더를 사용합니다.
# DATA_DIR=/data
